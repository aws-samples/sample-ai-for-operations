# Profile v1 is the default for local demos.
SESSION_PROFILE=v1
SESSION_PATH=sessions/session.json

# Shared settings.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5
BEDROCK_REGION=us-east-1

# Optional for local demos. Required for a public deployment after a versioned
# Amazon Bedrock Guardrail is created and tested for this use case.
# BEDROCK_GUARDRAIL_ID=<published-guardrail-id>
# BEDROCK_GUARDRAIL_VERSION=<published-guardrail-version>

# Profile v2: uncomment and provide deployment-specific values.
# SESSION_PROFILE=v2
# AGENTCORE_MEMORY_ID=<pre-provisioned-memory-id>
# AGENTCORE_REGION=us-east-1
# ASSESSMENT_ID=assessment-demo-001
# CONTRIBUTOR_ID=participant-platform-01

# Optional document retrieval only; not used for answer state.
# KNOWLEDGE_BASE_ID=<knowledge-base-id>

# Optional runtime settings (defaults shown).
# LOG_LEVEL=INFO
# DOCUMENTS_DIR=documents
# REPORTS_DIR=reports
# MAX_INPUT_JSON_BYTES=262144
# BEDROCK_MAX_TOKENS=4096
# AWS_DISCOVERY_MAX_ATTEMPTS=5
# AWS_DISCOVERY_RETRY_MODE=adaptive
