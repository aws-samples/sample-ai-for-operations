# Copy to .deploy.env (git-ignored) and edit. scripts/deploy.sh reads it.
# Required
SCHEDULE_TIMEZONE=Europe/Berlin

# Optional
NOTIFICATION_EMAIL=
SCHEDULE_EXPRESSION=cron(0 5 * * ? *)
REGION_ALLOWLIST=
REGION_EXCLUDE_LIST=
ENVIRONMENT_TAG_KEY=Environment
PRODUCTION_TAG_VALUES=prod,production
LIMIT_THRESHOLD_PERCENT=80
LOG_RETENTION_DAYS=90
# Optional: DevOps Agent hand-off. All three of URL, secret name and space ID, or none.
ENABLE_DEVOPS_AGENT_HANDOFF=false
DEVOPS_AGENT_WEBHOOK_URL=
# Name of the SSM SecureString parameter (in this account) holding the webhook secret.
WEBHOOK_SECRET_PARAMETER_NAME=
DEVOPS_AGENT_SPACE_ID=
# Seconds one investigation batch may run (default 2700; a live investigation took ~16 min).
INVESTIGATION_TIMEOUT_SECONDS=
# Cross-account only: the Agent Space account and a credential profile for it.
DEVOPS_AGENT_ACCOUNT_ID=
DEVOPS_AGENT_PROFILE=
