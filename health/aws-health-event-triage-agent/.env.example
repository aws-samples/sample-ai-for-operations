# Copy this file to .env and fill in the values from your `cdk deploy` stack outputs.
# .env is gitignored — never commit real values.

# Amazon Bedrock model used for classification (see README.md for approved model IDs)
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-5
BEDROCK_REGION=eu-west-1

# General-purpose AWS Region
AWS_REGION=eu-west-1

# Required in production — from the HealthTriageCoreStack / HealthTriageGuardrailStack outputs
SNS_TOPIC_ARN=
GUARDRAIL_ID=
GUARDRAIL_VERSION=DRAFT

# Optional
SYSTEM_PROMPT_S3_BUCKET=
SESSION_TABLE_NAME=health-triage-sessions
APP_CONTEXT_TABLE_NAME=
EKS_MCP_ENABLED=false
KMS_KEY_ARN=
